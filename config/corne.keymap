#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        c_jo {
            bindings = <&kp ENTER>;
            key-positions = <21 20>;
        };

        c_jk {
            bindings = <&kp BACKSPACE>;
            key-positions = <19 20>;
        };
    };

    behaviors {
        moP_kp: moP_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "MOP_KP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mt_B: mt_B {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_B";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
        };

        lt_B: lt_B {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_B";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <135>;
            flavor = "balanced";
        };
    };

    macros {
        qt: qt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp T>;
            label = "QT";
        };

        ex_qt: ex_qt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT_SIGN &kp T>;
            label = "EX_QT";
        };

        lm: lm {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mo 0 &kp LEFT_SHIFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mo 0 &kp LEFT_SHIFT>;

            label = "LM";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB             &kp Q  &ht LCTRL W  &lt_B 3 E        &kp R          &ht LA(LCTRL) T    &ht LA(LCTRL) Y           &kp U            &ht LCTRL I   &ht LEFT_ALT O  &kp P     &kp BACKSPACE
&mt LEFT_ALT ENTER  &kp A  &lt_B 3 S    &ht LEFT_META D  &ht LCTRL F    &ht LEFT_ALT G     &kp H                     &kp J            &kp K         &kp L           &kp SEMI  &kp SQT
&mo 4               &kp Z  &kp X        &kp C            &kp V          &kp B              &ht LEFT_META N           &kp M            &kp COMMA     &kp DOT         &kp FSLH  &kp ESC
                                        &kp LEFT_GUI     &moP_kp 1 TAB  &kp SPACE          &ht LEFT_SHIFT BACKSPACE  &moP_kp 2 ENTER  &kp LEFT_ALT
            >;
        };

        l01_move {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&ex_qt       &kp LEFT_SHIFT  &kp LEFT  &kp DOWN  &trans  &kp MINUS    &harp_n         &trans          &kp UP     &kp RIGHT  &ex_qt     &trans
&kp LS(RET)  &kp NUMBER_1    &kp N2    &kp N3    &kp N4  &kp N5       &kp N6          &kp N7          &kp N8     &kp N9     &kp N0     &kp BACKSLASH
&trans       &trans          &trans    &trans    &trans  &trans       &kp BACKSLASH   &kp UNDERSCORE  &trans     &trans     &kp CARET  &trans
                                       &kp LGUI  &trans  &trans       &kp LEFT_SHIFT  &kp SPACE       &kp LC(P)
            >;
        };

        l02_sp-chars {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&qt        &kp TILDE  &kp MINUS      &kp ASTERISK    &kp EXCL              &kp EQUAL           &kp COLON          &kp HASH               &kp AMPERSAND    &kp PLUS          &kp GRAVE   &trans
&kp CARET  &kp PIPE   &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp DOLLAR  &kp BACKSLASH
&trans     &trans     &kp AT_SIGN    &kp HASH        &kp DOLLAR            &kp PERCENT         &trans             &trans                 &trans           &trans            &trans      &kp ESCAPE
                                     &trans          &trans                &trans              &kp RET            &trans                 &kp RALT
            >;
        };

        l021_sp-chars2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        sys {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3       &bt BT_SEL 4    &kp F1            &kp F2        &kp F3      &kp F4   &trans            &trans
&trans      &trans        &out OUT_USB  &trans          &trans             &out OUT_TOG    &kp F5            &kp F6        &kp F7      &kp F8   &kp LS(LEFT_ALT)  &trans
&trans      &trans        &trans        &trans          &trans             &out OUT_BLE    &kp F9            &kp F10       &kp F11     &kp F12  &trans            &kp CLCK
                                        &kp K_PREVIOUS  &kp K_VOLUME_DOWN  &trans          &kp C_PLAY_PAUSE  &kp K_VOL_UP  &kp K_NEXT
            >;
        };
    };
};
