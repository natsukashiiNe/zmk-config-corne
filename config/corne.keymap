#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        l03_sup {
            bindings = <&mo 0>;
            key-positions = <36 41>;
        };

        l05_sup {
            bindings = <&mo 3>;
            key-positions = <37 40>;
        };
    };

    behaviors {
        space_ctrl: space_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            require-prior-idle-ms = <125>;
        };

        lgui_h_left: lgui_h_left {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_H_LEFT";
            bindings = <&kp H>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_j_down: lgui_j_down {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_J_DOWN";
            bindings = <&kp H>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_k_up: lgui_k_up {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_K_UP";
            bindings = <&kp H>, <&kp UP>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_l_right: lgui_l_right {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_L_RIGHT";
            bindings = <&kp H>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_f_ctrl: lgui_f_ctrl {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_F_CTRL";
            bindings = <&kp H>, <&kp LCTRL>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_a_shift: lgui_a_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_A_SHIFT";
            bindings = <&kp H>, <&kp LCTRL>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };
    };

    macros {
        p_tmux: f_tmux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(P) &kp P>;
            label = "F_TMUX";
        };

        n_tmux: g_tmux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(P) &kp N>;
            label = "G_TMUX";
        };

        qt: qt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp T>;
            label = "QT";
        };

        ex_qt: ex_qt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT_SIGN &kp T>;
            label = "EX_QT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB             &kp Q  &kp W  &kp E  &kp R  &kp T                      &kp Y                 &kp U  &kp I         &kp O    &kp P     &kp BACKSPACE
&mt LEFT_ALT ENTER  &kp A  &kp S  &kp D  &kp F  &kp G                      &kp H                 &kp J  &kp K         &kp L    &kp SEMI  &kp SQT
&mo 4               &kp Z  &kp X  &kp C  &kp V  &kp B                      &kp N                 &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp ESC
                                  &mo 3  &mo 1  &space_ctrl LCTRL SPACE    &mt LEFT_SHIFT ENTER  &mo 2  &kp LEFT_ALT
            >;
        };

        l01_move {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&ex_qt       &none         &p_tmux  &trans    &trans  &trans    &trans          &trans          &trans     &n_tmux    &trans  &trans
&kp LS(RET)  &kp NUMBER_1  &kp N2   &kp N3    &kp N4  &kp N5    &kp N6          &kp N7          &kp N8     &kp N9     &kp N0  &kp BACKSLASH
&trans       &trans        &trans   &kp HOME  &trans  &trans    &kp BACKSLASH   &kp UNDERSCORE  &kp END    &kp GRAVE  &trans  &trans
                                    &kp LGUI  &trans  &trans    &kp LEFT_SHIFT  &mo 3           &kp LC(P)
            >;
        };

        l02_sp-chars {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&qt       &kp TILDE  &kp MINUS      &kp ASTERISK    &kp EXCL              &kp EQUAL           &trans             &trans                 &kp AMPERSAND    &kp PLUS          &kp GRAVE   &trans
&kp PIPE  &kp CARET  &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp DOLLAR  &kp BACKSLASH
&trans    &trans     &trans         &kp AT_SIGN     &trans                &kp UNDERSCORE      &trans             &trans                 &trans           &trans            &trans      &kp ESCAPE
                                    &trans          &trans                &trans              &kp RET            &trans                 &kp RALT
            >;
        };

        hyprtext {
            bindings = <
&trans  &kp LG(Q)  &kp LG(W)  &kp LG(E)  &kp LG(R)  &kp LG(T)            &kp LG(Y)  &kp LG(U)       &kp LG(I)      &kp LG(O)    &kp LG(P)      &trans
&trans  &kp LG(A)  &kp LG(S)  &kp LG(D)  &kp LCTRL  &kp LC(BACKSPACE)    &kp LEFT   &kp DOWN        &kp UP         &kp RIGHT    &kp BACKSPACE  &kp DEL
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(B)            &kp LG(N)  &kp LG(M)       &kp LG(COMMA)  &kp LG(DOT)  &kp LG(FSLH)   &trans
                              &trans     &trans     &trans               &trans     &kp LEFT_SHIFT  &kp BACKSPACE
            >;
        };

        sys {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3       &bt BT_SEL 4    &kp F1            &kp F2        &kp F3      &kp F4   &trans  &bt BT_CLR_ALL
&trans  &trans        &out OUT_USB  &trans          &trans             &out OUT_TOG    &kp F5            &kp F6        &kp F7      &kp F8   &trans  &trans
&trans  &trans        &trans        &trans          &trans             &out OUT_BLE    &kp F9            &kp F10       &kp F11     &kp F12  &trans  &kp CLCK
                                    &kp K_PREVIOUS  &kp K_VOLUME_DOWN  &trans          &kp C_PLAY_PAUSE  &kp K_VOL_UP  &kp K_NEXT
            >;
        };
    };
};
