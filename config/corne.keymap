#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        hypr_move {
            bindings = <&mo 3>;
            key-positions = <36 41>;
        };
    };

    behaviors {
        alt_layer3: alt_layer3 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_LAYER3";
            bindings = <&kp LEFT_ALT>, <&mo 3>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        ent_l04: ent_l04 {
            compatible = "zmk,behavior-hold-tap";
            label = "ENT_L04";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-unless-interrupted";
            hold-while-undecided;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB         &kp Q  &kp W  &kp E     &kp R  &kp T              &kp Y                 &kp U  &kp I        &kp O    &kp P     &kp BSPC
&kp LEFT_ALT    &kp A  &kp S  &kp D     &kp F  &kp G              &kp H                 &kp J  &kp K        &kp L    &kp SEMI  &kp SQT
&ent_l04 4 RET  &kp Z  &kp X  &kp C     &kp V  &kp B              &kp N                 &kp M  &kp COMMA    &kp DOT  &kp FSLH  &kp ESC
                              &kp LGUI  &mo 1  &mt LCTRL SPACE    &mt LEFT_SHIFT ENTER  &mo 2  &alt_layer3
            >;
        };

        l01_move {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans       &kp N1          &kp N2  &kp N3    &kp N4     &kp N5       &kp N6    &kp N7          &kp N8    &kp N9     &kp N0         &kp DEL
&kp LS(RET)  &kp LEFT_SHIFT  &trans  &trans    &kp LCTRL  &trans       &kp LEFT  &kp DOWN        &kp UP    &kp RIGHT  &kp BACKSPACE  &trans
&trans       &trans          &trans  &trans    &trans     &trans       &kp HOME  &kp UNDERSCORE  &kp END   &trans     &trans         &trans
                                     &kp LGUI  &trans     &kp SPACE    &kp RET   &kp BACKSPACE   &kp RALT
            >;
        };

        l02_sp-chars {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp HASH  &kp TILDE  &kp MINUS      &kp CARET       &kp ASTERISK          &kp EQUAL           &kp EXCLAMATION    &kp AMPS               &kp DOLLAR       &kp PLUS          &kp GRAVE  &trans
&kp PIPE  &kp CARET  &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp GREATER_THAN  &trans     &kp BACKSLASH
&trans    &trans     &trans         &kp AT_SIGN     &kp PERCENT           &kp UNDERSCORE      &trans             &trans                 &trans           &trans            &trans     &trans
                                    &kp LGUI        &trans                &kp SPACE           &kp RET            &trans                 &kp RALT
            >;
        };

        l03_hypr {
            bindings = <
&trans  &kp LG(N1)  &kp LG(N2)  &kp LG(N3)  &kp LG(N4)  &kp LG(N5)    &trans  &trans     &trans  &trans  &trans  &trans
&trans  &kp LG(N6)  &kp LG(N7)  &kp LG(N8)  &kp LG(N9)  &kp LG(N0)    &trans  &kp LSHFT  &trans  &trans  &trans  &kp LEFT_ALT
&trans  &kp LG(A)   &kp LG(B)   &kp LG(C)   &kp LG(D)   &kp LG(E)     &trans  &trans     &trans  &trans  &trans  &trans
                                &trans      &trans      &trans        &trans  &trans     &trans
            >;
        };

        l04_sys {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3       &bt BT_SEL 4    &kp F1    &kp F2        &kp F3      &kp F4   &trans  &bt BT_CLR_ALL
&trans  &trans        &out OUT_USB  &trans          &trans             &out OUT_TOG    &kp F5    &kp F6        &kp F7      &kp F8   &trans  &trans
&trans  &trans        &trans        &trans          &trans             &out OUT_BLE    &kp F9    &kp F10       &kp F11     &kp F12  &trans  &trans
                                    &kp K_PREVIOUS  &kp K_VOLUME_DOWN  &trans          &kp K_PP  &kp K_VOL_UP  &kp K_NEXT
            >;
        };
    };
};
