#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    combos {
        compatible = "zmk,combos";

        l03_sup {
            bindings = <&mo 0>;
            key-positions = <36 41>;
        };

        l05_sup {
            bindings = <&mo 0>;
            key-positions = <37 40>;
        };

        go_flayer {
            bindings = <&tog 5>;
            key-positions = <24 35>;
        };

        tablet_def {
            bindings = <&tog 1>;
            key-positions = <35 23 11>;
        };
    };

    behaviors {
        space_ctrl: space_ctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "SPACE_CTRL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
            require-prior-idle-ms = <125>;
        };

        lgui_h_left: lgui_h_left {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_H_LEFT";
            bindings = <&kp H>, <&kp LEFT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_j_down: lgui_j_down {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_J_DOWN";
            bindings = <&kp H>, <&kp DOWN>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_k_up: lgui_k_up {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_K_UP";
            bindings = <&kp H>, <&kp UP>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_l_right: lgui_l_right {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_L_RIGHT";
            bindings = <&kp H>, <&kp RIGHT>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_f_ctrl: lgui_f_ctrl {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_F_CTRL";
            bindings = <&kp H>, <&kp LCTRL>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        lgui_a_shift: lgui_a_shift {
            compatible = "zmk,behavior-mod-morph";
            label = "LGUI_A_SHIFT";
            bindings = <&kp H>, <&kp LCTRL>;

            #binding-cells = <0>;
            mods = <(MOD_LGUI)>;
        };

        alt_left_h: alt_left_h {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_LEFT_H";
            bindings = <&kp LEFT>, <&kp LG(H)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        alt_down_j: alt_down_j {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_DOWN_J";
            bindings = <&kp DOWN>, <&kp LG(J)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        alt_up_k: alt_up_k {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_UP_K";
            bindings = <&kp UP_ARROW>, <&kp LG(K)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        alt_right_l: alt_right_l {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_RIGHT_L";
            bindings = <&kp RIGHT>, <&kp LG(L)>;

            #binding-cells = <0>;
            mods = <(MOD_LALT)>;
        };

        gui_hyprtext: gui_hyprtext {
            compatible = "zmk,behavior-hold-tap";
            label = "GUI_HYPRTEXT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        lmove: lmove {
            compatible = "zmk,behavior-hold-tap";
            label = "LMOVE";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        flayer: flayer {
            compatible = "zmk,behavior-hold-tap";
            label = "FLAYER";
            bindings = <&mo>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mo_kp: mo_kp {
            compatible = "zmk,behavior-hold-tap";
            label = "MO_KP";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        hp_balanced: hp_balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "HP_BALANCED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <175>;
            tapping-term-ms = <300>;
            flavor = "balanced";
        };
    };

    macros {
        p_tmux: f_tmux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(P) &kp P>;
            label = "F_TMUX";
        };

        n_tmux: g_tmux {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(P) &kp N>;
            label = "G_TMUX";
        };

        qt: qt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp T>;
            label = "QT";
        };

        ex_qt: ex_qt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp AT_SIGN &kp T>;
            label = "EX_QT";
        };

        harp_n: harp_n {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(G) &kp I>;
            label = "HARP_N";
        };

        harp_p: harp_p {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(G) &kp E>;
            label = "HARP_P";
        };

        cf1: cf1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(F1)) &tog 5>;
            label = "CF1";
        };

        cf2: cf2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(F2)) &tog 5>;
            label = "CF2";
        };

        cf3: cf3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(F3)) &tog 5>;
            label = "CF3";
        };

        cf4: cf4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(F4)) &tog 5>;
            label = "CF4";
        };

        cf5: cf5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(F5)) &tog 5>;
            label = "CF5";
        };

        cf6: cf6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(F6)) &tog 5>;
            label = "CF6";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp TAB             &kp Q  &kp W  &kp E         &kp R         &kp T                       &kp Y                 &kp U           &kp I                            &kp O    &kp P     &kp BACKSPACE
&mt LEFT_ALT ENTER  &kp A  &kp S  &kp D         &kp F         &kp G                       &kp H                 &kp J           &kp K                            &kp L    &kp SEMI  &mt LCTRL SQT
&mo 4               &kp Z  &kp X  &kp C         &kp V         &kp B                       &kp N                 &kp M           &kp COMMA                        &kp DOT  &kp FSLH  &kp ESC
                                  &kp LEFT_GUI  &mo_kp 2 TAB  &hp_balanced LCTRL SPACE    &mt LEFT_SHIFT SPACE  &mo_kp 3 ENTER  &hp_balanced LEFT_ALT BACKSPACE
            >;
        };

        tab_def {
            bindings = <
&kp TAB             &kp Q  &kp W  &kp E         &kp R  &kp T                      &kp Y                 &kp U  &kp I         &kp O    &kp P     &kp BACKSPACE
&mt LEFT_ALT ENTER  &kp A  &kp S  &kp D         &kp F  &kp G                      &kp H                 &kp J  &kp K         &kp L    &kp SEMI  &kp SQT
&mo 4               &kp Z  &kp X  &kp C         &kp V  &kp B                      &kp N                 &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp ESC
                                  &kp LEFT_ALT  &mo 2  &space_ctrl LCTRL SPACE    &mt LEFT_SHIFT SPACE  &mo 3  &kp LEFT_ALT
            >;
        };

        l01_move {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BSPC |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&ex_qt       &kp LEFT_SHIFT  &kp LEFT  &kp DOWN  &p_tmux  &harp_p    &harp_n         &n_tmux         &kp UP     &kp RIGHT  &trans     &trans
&kp LS(RET)  &kp NUMBER_1    &kp N2    &kp N3    &kp N4   &kp N5     &kp N6          &kp N7          &kp N8     &kp N9     &kp N0     &kp BACKSLASH
&trans       &trans          &trans    &trans    &trans   &trans     &kp BACKSLASH   &kp UNDERSCORE  &trans     &trans     &kp CARET  &trans
                                       &kp LGUI  &trans   &trans     &kp LEFT_SHIFT  &trans          &kp LC(P)
            >;
        };

        l02_sp-chars {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BSPC |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&qt       &kp TILDE  &kp MINUS      &kp ASTERISK    &kp EXCL              &kp EQUAL           &trans             &trans                 &kp AMPERSAND    &kp PLUS          &kp GRAVE   &trans
&kp PIPE  &kp CARET  &kp LESS_THAN  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE  &kp GREATER_THAN  &kp DOLLAR  &kp BACKSLASH
&trans    &trans     &kp AT_SIGN    &kp HASH        &trans                &kp PERCENT         &trans             &trans                 &trans           &trans            &trans      &kp ESCAPE
                                    &trans          &trans                &trans              &kp RET            &trans                 &kp RALT
            >;
        };

        sys {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3       &bt BT_SEL 4    &kp F1            &kp F2        &kp F3      &kp F4   &trans            &trans
&trans      &trans        &out OUT_USB  &trans          &trans             &out OUT_TOG    &kp F5            &kp F6        &kp F7      &kp F8   &kp LS(LEFT_ALT)  &trans
&trans      &trans        &trans        &trans          &trans             &out OUT_BLE    &kp F9            &kp F10       &kp F11     &kp F12  &trans            &kp CLCK
                                        &kp K_PREVIOUS  &kp K_VOLUME_DOWN  &trans          &kp C_PLAY_PAUSE  &kp K_VOL_UP  &kp K_NEXT
            >;
        };

        flayer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &cf1    &cf2    &cf3    &cf4    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &cf5    &cf6    &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
